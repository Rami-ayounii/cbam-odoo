# Copy to .env and fill in real values. Never commit .env.

# No TS_AUTHKEY here - docker-compose.yml no longer runs a Tailscale
# sidecar (see that file's own header comment: the admin console's
# key-generation page produces auth keys the real control server rejects
# outright). This host is expected to already run its own Tailscale
# client natively and be authenticated on the tailnet.

# PostgreSQL credentials (used by both postgres and odoo containers)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-strong-password

# Odoo admin credentials
ODOO_DB=cbam
ODOO_USER=admin
ODOO_PASSWORD=replace-with-strong-password

# Hardworker reachability. Hardworker also has no dedicated Tailscale
# identity anymore (see hardworker/docker-compose.yml's header comment) -
# use that host's own tailnet IP or MagicDNS hostname (`tailscale status`
# on that machine), not "cbam-hardworker".
# For local dev before Hardworker is up, these can temporarily point at any
# OpenAI-compatible cloud endpoint (base URL + API key) instead - LLMClient
# doesn't care which. Swap back to the tailnet URL before anything resembling
# a real run: a cloud endpoint breaks the "local LLM host, zero budget"
# architecture in projecthandoff.md and is for throwaway testing only.
OLLAMA_BASE_URL=http://<hardworkers-own-tailnet-ip-or-magicdns-name>:8443
OLLAMA_API_KEY=same-key-as-hardworker-env-file

# Agent loop settings
LLM_MODEL=qwen2.5:14b-instruct
MAX_AGENT_ITERATIONS=9

# Gates POST /jobs and GET /jobs/{id}/status - the orchestrator's HTTP API
# has no auth of its own otherwise, and is reachable from any tailnet peer
# that can reach cbam-softworker. Generate with: openssl rand -hex 32.
# Whatever Odoo-side code eventually calls the orchestrator must send this
# as the X-Api-Key header.
ORCHESTRATOR_API_KEY=replace-with-strong-key
