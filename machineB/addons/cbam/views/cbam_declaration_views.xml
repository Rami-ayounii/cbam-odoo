<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cbam_declaration_tree" model="ir.ui.view">
        <field name="name">cbam.declaration.tree</field>
        <field name="model">cbam.declaration</field>
        <field name="arch" type="xml">
            <tree string="CBAM Declarations">
                <field name="declarant_id"/>
                <field name="reporting_year"/>
                <field name="status"/>
                <field name="total_quantity_tonnes"/>
                <field name="is_exempt"/>
                <field name="submission_date"/>
            </tree>
        </field>
    </record>

    <record id="view_cbam_declaration_form" model="ir.ui.view">
        <field name="name">cbam.declaration.form</field>
        <field name="model">cbam.declaration</field>
        <field name="arch" type="xml">
            <form string="CBAM Declaration">
                <sheet>
                    <group>
                        <group>
                            <field name="declarant_id"/>
                            <field name="reporting_year"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="submission_date"/>
                            <field name="total_quantity_tonnes" readonly="1"/>
                            <field name="is_exempt" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Declaration Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="good_id"/>
                                    <field name="installation_id"/>
                                    <field name="quantity_tonnes"/>
                                    <field name="data_source"/>
                                    <field name="direct_emissions_actual"/>
                                    <field name="indirect_emissions_actual"/>
                                    <field name="emission_factor_id"/>
                                    <field name="carbon_price_paid_origin"/>
                                    <field name="precursor_emissions"/>
                                    <field name="embedded_emissions_total" readonly="1"/>
                                    <field name="certificates_required" readonly="1"/>
                                    <button name="action_lookup_emission_factor"
                                            type="object"
                                            string="Lookup Default EF"
                                            icon="fa-search"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cbam_declaration" model="ir.actions.act_window">
        <field name="name">CBAM Declarations</field>
        <field name="res_model">cbam.declaration</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
