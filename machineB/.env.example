# Copy to .env and fill in real values. Never commit .env.

# Tailscale auth key (ephemeral, reusable)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXX

# PostgreSQL credentials (used by both postgres and odoo containers)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-strong-password

# Odoo admin credentials
ODOO_DB=cbam
ODOO_USER=admin
ODOO_PASSWORD=replace-with-strong-password

# Machine A reachability (use the Tailscale IP or MagicDNS name of Machine A)
OLLAMA_BASE_URL=http://cbam-machineA:8443
OLLAMA_API_KEY=same-key-as-machineA-env-file

# Agent loop settings
LLM_MODEL=qwen2.5:7b-instruct
MAX_AGENT_ITERATIONS=9
