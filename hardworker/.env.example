# Copy to .env and fill in real values. Never commit .env.

# No TS_AUTHKEY here - docker-compose.yml no longer runs a Tailscale
# sidecar (the admin console's key-generation page produces auth keys the
# real control server rejects outright; see that file's own header
# comment). This host is expected to already run its own Tailscale client
# natively and be authenticated on the tailnet.

# API key nginx will require on every request to /
# Generate with: openssl rand -hex 32
OLLAMA_API_KEY=replace-with-a-long-random-string
