# Copy to .env and fill in real values. Never commit .env.

# Tailscale auth key (ephemeral, reusable — generate at https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXX

# API key nginx will require on every request to /
# Generate with: openssl rand -hex 32
OLLAMA_API_KEY=replace-with-a-long-random-string
